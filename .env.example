# Which provider chat.js uses when you run createModelClient() with no
# argument. One of: anthropic, openai, gemini, ollama. Defaults to
# "anthropic" if you leave this out entirely.
MODEL_PROVIDER=anthropic

# ── Anthropic (active by default) ───────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_MODEL=claude-sonnet-4-6      # optional override, shown is the default

# ── OpenAI: only needed if MODEL_PROVIDER=openai ───────────────────────
# npm install openai
# OPENAI_API_KEY=sk-your-openai-key-here
# OPENAI_MODEL=gpt-4.1                   # optional override, shown is the default

# ── Gemini: only needed if MODEL_PROVIDER=gemini ───────────────────────
# npm install @google/genai
# GEMINI_API_KEY=your-gemini-key-here
# GEMINI_MODEL=gemini-2.5-flash          # optional override, shown is the default

# ── Ollama: only needed if MODEL_PROVIDER=ollama, no API key required ──
# Install Ollama, then: ollama pull llama3.1
# OLLAMA_BASE_URL=http://localhost:11434 # optional override, shown is the default
# OLLAMA_MODEL=llama3.1                  # optional override, shown is the default

# ── Shared ───────────────────────────────────────────────────────────────
# MAX_TOKENS=1024                        # optional override, applies to all providers

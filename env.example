# Active provider — used by default in chat.js
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Uncomment the line below only if you switch chat.js to the OpenAI block
# OPENAI_API_KEY=sk-your-openai-key-here

# Uncomment the line below only if you switch chat.js to the Gemini block
# GEMINI_API_KEY=your-gemini-key-here

# Ollama runs locally and needs no API key — nothing to add here for that one
